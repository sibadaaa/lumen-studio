# ---------- LUMEN BFF ----------
NODE_ENV=development
HOST=127.0.0.1
PORT=8787
APP_ORIGIN=http://127.0.0.1:5173

# 32+ random bytes. If empty, the server generates data/master.key (0600).
# Generate: openssl rand -base64 48
APP_SECRET=replace-with-a-random-secret

# local single-user workspace data
DATA_DIR=./data
DEFAULT_PROVIDER=mock

# task queue / polling
GENERATION_CONCURRENCY=2
PROVIDER_POLL_MS=2500
TASK_TIMEOUT_IMAGE_SEC=180
TASK_TIMEOUT_VIDEO_SEC=900
TASK_TIMEOUT_STORYBOARD_SEC=1800

# media
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MAX_UPLOAD_MB=20
MAX_BATCH_UPLOAD_MB=120
# Set true only for local gateways that return private-network media URLs.
LUMEN_ALLOW_PRIVATE_FETCH=false

# If the BFF is reachable by a Provider, set a public origin for local media.
# Example: PUBLIC_BASE_URL=https://lumen.example.com
PUBLIC_BASE_URL=

# ---------- optional Ark bootstrap ----------
# ARK_API_KEY=
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# ARK_IMAGE_MODEL=doubao-seedream-4-0-250828
# ARK_VIDEO_MODEL=doubao-seedance-1-0-pro-250528

# ---------- optional custom OpenAI-compatible gateway ----------
# Applied to the "custom" provider when that provider has no saved key yet.
# Base URL should include the /v1 prefix used by /models and /images/generations.
# CUSTOM_API_KEY=
# CUSTOM_BASE_URL=https://api.example.com/v1
# CUSTOM_IMAGE_MODEL=custom-image-model
# CUSTOM_VIDEO_MODEL=custom-video-model
