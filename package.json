{
  "name": "lumen-studio",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/index.ts",
    "dev:all": "concurrently -k -n web,bff -c cyan,amber \"npm:dev\" \"npm:dev:server\"",
    "server": "tsx server/index.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test:server": "node --import tsx --test server/tests/*.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13",
    "i18next": "^26.5.6",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-i18next": "^17.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
