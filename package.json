{
  "name": "lumen-studio",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/index.ts",
    "dev:all": "concurrently -k -n web,bff -c cyan,amber \"npm:dev\" \"npm:dev:server\"",
    "server": "tsx server/index.ts",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "vue-tsc -b --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test:server": "node --import tsx --test server/tests/*.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13",
    "i18next": "^26.5.6",
    "lucide-vue-next": "^0.468.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "concurrently": "^9.2.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vue-tsc": "^3.3.13"
  }
}
